<diagram name="1. Context" id="1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="C4 Level 1 — Context: shop-microservices" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="-70" width="900" height="40" as="geometry"/></mxCell><mxCell id="buyer" value="&lt;b style=&quot;font-size:15px&quot;&gt;Покупатель&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Смотрит каталог, кладёт товары в корзину, оформляет заказ" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#fff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="0" width="240" height="100" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b style=&quot;font-size:15px&quot;&gt;Администратор&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Ведёт каталог, цены и остатки, обрабатывает заказы" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#fff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="0" width="240" height="100" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b style=&quot;font-size:15px&quot;&gt;Shop-microservices&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Интернет-магазин: каталог товаров, аккаунты, заказы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#fff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="380" height="120" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b style=&quot;font-size:15px&quot;&gt;Платёжная система&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Приём онлайн-оплаты (например, ЮK